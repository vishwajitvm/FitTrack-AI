# ---------------------------------------------------------------
# FitTrack AI — frontend environment
# Copy this file to `.env` (or `.env.local`) and adjust if needed.
# ---------------------------------------------------------------

# Where the browser reaches the FastAPI backend.
# Docker and local setups both expose the backend on port 8000.
# NOTE: NEXT_PUBLIC_* values are baked in at build time — rebuild after changing.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Name shown in the sidebar and browser tab.
NEXT_PUBLIC_APP_NAME=FitTrack AI
