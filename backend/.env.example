# =============================================================================
#  FitTrack AI — BACKEND environment
#  Copy this file to `.env` (same folder) and adjust.  `cp .env.example .env`
#
#  • Without Docker: the values below work as-is for a local PostgreSQL/Redis/Ollama.
#    No PostgreSQL? Use the SQLite line under DATABASE_URL instead — zero setup.
#  • With Docker Compose: this same file is used. docker-compose.yml overrides the
#    hostnames (db, redis, ollama) automatically, so you do NOT need to edit them.
# =============================================================================

# ---------------------------------------------------------------- App
APP_NAME=FitTrack AI
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
# Comma-separated list of frontend URLs allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Used to ENCRYPT the API keys you save from the UI. Set a long random value once and
# keep it — if you change it, re-enter your keys in the AI Providers page.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# ---------------------------------------------------------------- PostgreSQL
# Used by the `db` container on first start, and to build DATABASE_URL below.
POSTGRES_USER=fittrack
POSTGRES_PASSWORD=fittrack
POSTGRES_DB=fittrack
POSTGRES_PORT=5432

# Async SQLAlchemy URL. Tables are created automatically by Alembic migrations on startup.
DATABASE_URL=postgresql+asyncpg://fittrack:fittrack@localhost:5432/fittrack
# Zero-setup alternative (no PostgreSQL needed, no pgvector):
# DATABASE_URL=sqlite+aiosqlite:///./data/fittrack.db
# Docker Compose sets DATABASE_HOST=db automatically; leave it unset otherwise.
# DATABASE_HOST=
DB_ECHO=false

# ---------------------------------------------------------------- Redis (optional)
# Leave empty to use an in-memory cache.
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------- Files
UPLOAD_DIR=./data/uploads
# fitness_tracker.xlsx and workout_tracker.csv are kept in sync here
EXPORT_DIR=./data/exports
MAX_UPLOAD_MB=15
AUTO_SYNC_FILES=true

# Seed the baseline profile + Day 1 / Day 2 records on the very first start
SEED_BASELINE=true

# ---------------------------------------------------------------- On-device machine learning
# Small ONNX models (~0.23 GB total, CPU) for semantic food search, meal-photo recognition and
# your personal meal memory. Downloaded once into MODEL_DIR. See docs/ML.md.
ML_ENABLED=true
ML_PRELOAD=true
ML_TEXT_MODEL=nomic-ai/nomic-embed-text-v1.5-Q
ML_VISION_MODEL=nomic-ai/nomic-embed-vision-v1.5-Q
MODEL_DIR=./data/models

# ---------------------------------------------------------------- AI routing
# Ollama = local last-resort fallback. Can also be changed from the Ollama page.
OLLAMA_BASE_URL=http://localhost:11434
LLM_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS=12
LLM_RATE_LIMIT_COOLDOWN_SECONDS=60

# ---------------------------------------------------------------- Nutrition & search
# DEMO_KEY works for light use; get a free key at https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY=DEMO_KEY
TAVILY_API_KEY=
SERPER_API_KEY=

# ---------------------------------------------------------------- Provider API keys (OPTIONAL)
# Normally you add keys in the app (AI Providers page) — those are encrypted in the database
# and take priority over these. Only providers that are FREE FOREVER with just a key are
# supported (no card, no trial credits). Get keys here:
#   Gemini      https://aistudio.google.com/app/apikey        (best for meal photos)
#   Groq        https://console.groq.com/keys                 (fastest text/reasoning)
#   OpenRouter  https://openrouter.ai/keys                    (":free" models only)
#   Cloudflare  https://dash.cloudflare.com/profile/api-tokens (+ Account ID)
#   NVIDIA      https://build.nvidia.com/settings/api-keys
#   Mistral     https://console.mistral.ai/api-keys           (free plan trains on prompts)
#   Z.ai        https://z.ai/manage-apikey/apikey-list
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
NVIDIA_API_KEY=
MISTRAL_API_KEY=
ZAI_API_KEY=
# Self-hosted OpenAI-compatible server (optional)
CUSTOM_LLM_API_KEY=
